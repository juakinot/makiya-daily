# Modo de IA: "simulated" (por defecto, reglas locales) | "remote" (llama a /api/ai/interpret en tu backend)
VITE_AI_MODE=simulated
# Persistencia: "local" (demo en el navegador) | "supabase" (requiere implementar el adaptador; ver supabase/schema.sql)
VITE_DATA_MODE=local
# Solo claves públicas (anon) pueden ir en el frontend. NUNCA pongas aquí claves de servicio ni de proveedores de IA.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
